# Ignore virtual environment directory
.venv/

# Ignore docs directory, except the hand-authored architecture diagram
# (fleet-config#256 companion convention — must be tracked). Note: the
# directory itself can't be excluded with a trailing "/" here, or git never
# descends into it to see the negation below.
docs/*
!docs/architecture.mmd

# Ignore config.json file and .env file in the process directory
config.json
process/.env

# Ignore Python cache files
__pycache__/

# Ignore catboost_info directory with learning data
catboost_info/

# supabase cli
supabase/.temp/cli-latest
supabase/.branches/_current_branch

# Ignore .env file
.env

