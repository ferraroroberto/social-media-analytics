# This file lists ONLY the variables the application actually reads via
# `os.getenv(...)` (see `src/data/database.py`, `src/api/prediction_api.py`,
# `dash_app/app.py`, `src/utils/config.py`, `tools/supabase_connection_check.py`).
# Adding a variable here does nothing until code reads it — the previous
# DATABASE_URL, MLflow, feature-store/experiment, external social-API token,
# and logging variables were removed as unread (see #53).

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Dashboard Configuration
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8050
DASHBOARD_DEBUG=true

# Model Configuration
MODEL_PATH=./models
